# Backend environment variables (copy to .env for local `go run`, or supply via
# docker-compose / Render). Values here are placeholders - never commit real .env.
# Vars marked REQUIRED cause the app to log.Fatal at startup if missing.

# --- Database (REQUIRED: DB_USER, DB_HOST, DB_NAME, PGSSLMODE, PGCHANNELBINDING) ---
DB_USER=finai
DB_PASSWORD=finai
DB_HOST=localhost
DB_PORT=5432                 # optional, defaults to 5432
DB_NAME=finai
PGSSLMODE=disable            # local Postgres: disable | Neon: require
PGCHANNELBINDING=disable     # local Postgres: disable | Neon: require

# --- Server (REQUIRED) ---
PORT=8080

# --- JWT / auth (all REQUIRED; TTLs parsed by time.ParseDuration, e.g. 15m, 168h) ---
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TTL=15m
REFRESH_TTL=168h
RESET_PASSWORD_TTL=1h

# --- Seeded admin user (all REQUIRED) ---
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@finai.local
ADMIN_PASSWORD=admin12345    # must be at least 8 characters

# --- Frontend origin (REQUIRED; used for password-reset links) ---
FRONTEND_URL=http://localhost:5173

# --- AI (OPTIONAL: without OPENAI_API_KEY the /ai endpoints return 503) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini                    # optional, has a default
OPENAI_BASE_URL=https://api.openai.com/v1    # optional, has a default

# --- Email (OPTIONAL: SMTP provider is wired by default) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Resend alternative (currently commented out in main.go):
RESEND_API_KEY=
RESEND_FROM=
